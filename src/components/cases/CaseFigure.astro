---
// A composed image between the text of a case (src/styles/case.css), with a caption. Wide boards
// (rows of screens or posters) pass `phone`: a version with fewer, larger elements in fewer
// columns, shown below 768px (made by scripts/cases/case-phone-boards.py). A `wide` board without
// one keeps its size on phones and scrolls sideways instead.
import { shot } from "../../lib/shots";

interface Props {
  name: string; // path in src/assets/, e.g. "cases/crisscross/crisscross-cards.png"
  phone?: string; // the phone version, same form
  alt: string;
  caption: string;
  wide?: boolean;
}
const { name, phone, alt, caption, wide = false } = Astro.props;
const img = await shot(name);
const small = phone ? await shot(phone) : undefined;
const scroll = wide && !small;
const FULL = "(max-width: 767px) calc(100vw - 40px), calc(100vw - 64px)";
---

<figure class="article__media">
  <div class:list={[{ article__scroll: scroll }]} tabindex={scroll ? 0 : undefined}>
    <picture>
      {small && <source media="(max-width: 767px)" srcset={small.srcset} sizes={FULL} width={small.width} height={small.height} />}
      <img
        class:list={["article__image", { "article__image--wide": scroll }]}
        src={img.src}
        srcset={img.srcset}
        sizes={scroll ? "(max-width: 767px) 760px, calc(100vw - 64px)" : FULL}
        width={img.width}
        height={img.height}
        alt={alt}
        loading="lazy"
        decoding="async"
      />
    </picture>
  </div>
  <figcaption>{caption}</figcaption>
</figure>
