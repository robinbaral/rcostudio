  const MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
  const pad = (n: number) => String(n).padStart(2, "0");
  const stamp = (d: Date) =>
    `${MONTHS[d.getMonth()]} ${String(d.getDate()).padStart(2, " ")} ${pad(d.getHours())}:${pad(d.getMinutes())}:${pad(d.getSeconds())}`;
  const esc = (t: string) => t.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");

  document.querySelectorAll<HTMLElement>("[data-pl-hero]").forEach((hero) => {
    const layer = hero.querySelector<HTMLElement>("[data-pl-lines]")!;
    // The newest line is stamped "now"; earlier ones count back by their offsets.
    const now = Date.now();
    const lines = LOG_ENTRIES.map(([s, rest]) => `${stamp(new Date(now - s * 1000))} ${rest}`);
    layer.innerHTML = [...lines, ...lines].map((l) => `<div>${esc(l)}</div>`).join("");

    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    let total = 0, step = 0, target = 0, pos = 0, timer = 0, frame = 0, running = false;
    const measure = () => {
      total = layer.scrollHeight / 2;
      step = (layer.firstElementChild as HTMLElement).offsetHeight;
    };

    // New lines arrive in irregular bursts with short quiet gaps, like a real log.
    const next = () => {
      const r = Math.random();
      let delay = 220 + Math.random() * 580, count = 1;
      if (r > 0.5 && r < 0.72) delay = 25 + Math.random() * 65;
      else if (r >= 0.72 && r < 0.88) { delay = 350 + Math.random() * 550; count = 2 + Math.floor(Math.random() * 2); }
      else if (r >= 0.88) delay = 700 + Math.random() * 1100;
      timer = window.setTimeout(() => {
        target += count * step;
        while (target >= total) { target -= total; pos -= total; }
        next();
      }, delay);
    };
    const render = () => {
      pos += (target - pos) * 0.16;
      layer.style.transform = `translateY(${-pos}px)`;
      frame = requestAnimationFrame(render);
    };

    const start = () => { if (running) return; running = true; measure(); next(); frame = requestAnimationFrame(render); };
    const stop = () => { running = false; clearTimeout(timer); cancelAnimationFrame(frame); };
    new IntersectionObserver(([e]) => (e.isIntersecting ? start() : stop())).observe(hero);
    new ResizeObserver(measure).observe(layer);
  });
</script>

<style>
  @font-face {
    font-family: "JetBrains Mono";
    src: url("/assets/fonts/jetbrains-mono-400.woff2") format("woff2");
    font-weight: 400;
    font-display: swap;
  }

  /* Full width always; the height follows 16:9 until it reaches 70% of the screen or 760px,
     so large desktops get a wider, calmer frame rather than a taller one. */
  .pl-hero-wrap {
    container-type: inline-size;
  }

  .pl-hero {
    position: relative;
    display: grid;
    place-items: center;
    margin: 0;
    height: max(320px, min(56.25cqw, 70svh, 760px));
    overflow: hidden;
    background-color: #141414;
    border-radius: 6px;
  }

  /* The stream fades in from the left, as on the Open Graph image, so the logo sits on calm
     ground; lines run off the right edge. */
  .pl-hero__stream {
    position: absolute;
    inset: 0 0 0 30%;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 35%);
    mask-image: linear-gradient(to right, transparent, #000 35%);
    pointer-events: none;
  }

  .pl-hero__lines {
    padding: 0 1em;
    font: 400 clamp(9px, 0.74vw, 14px) / 1.85 "JetBrains Mono", "Courier New", monospace;
    white-space: nowrap;
    color: rgb(255 255 255 / 0.075);
    will-change: transform;
    user-select: none;
  }

  .pl-hero__logo {
    position: relative;
    width: clamp(240px, 42%, 560px);
    height: auto;
  }

  @media screen and (max-width: 767px) {
    .pl-hero {
      height: min(125cqw, 84svh);
    }

    .pl-hero__stream {
      left: 0;
    }

    .pl-hero__lines {
      color: rgb(255 255 255 / 0.06);
    }

    .pl-hero__logo {
      width: 78%;
    }
  }
</style>
