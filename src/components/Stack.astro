---
// Everyday Stack: the section just above the footer, listing the tools R&Co works in (data in
// src/data/stack.ts). Inverted (the opposite of the page and the footer, like Services), so the
// footer reads as its own part when it's revealed underneath.
import { stack } from "../data/stack";
---

<section class="stack" id="stack" aria-labelledby="stack-heading">
  <div class="stack__head">
    <h2 class="stack__title" id="stack-heading">Everyday Stack</h2>
  </div>

  <dl class="stack__list">
    {
      stack.map((group) => (
        <div class="stack__group">
          <dt class="stack__name">{group.name}</dt>
          <dd class="stack__tools">
            <ul>
              {group.tools.map((tool) => (
                <li>{tool}</li>
              ))}
            </ul>
          </dd>
        </div>
      ))
    }
  </dl>
</section>

<style>
  .stack {
    --ink: var(--color-bg);
    --paper: var(--color-fg);
    --muted: color-mix(in srgb, var(--ink) 50%, var(--paper));
    --rule: color-mix(in srgb, var(--ink) 20%, var(--paper));
    display: flex;
    flex-flow: column;
    gap: var(--projects-padding-y);
    padding: var(--projects-padding-y) var(--gutter) calc(var(--projects-padding-y) * 1.5);
    color: var(--ink);
    background-color: var(--paper);
  }

  /* Same columns as Profile and Services, so the lists line up with the text above. */
  .stack__head,
  .stack__group {
    display: grid;
    grid-template-columns: clamp(300px, 26vw, 460px) minmax(0, 1fr);
    column-gap: clamp(48px, 6vw, 120px);
  }

  .stack__title {
    margin: 0;
    font-family: var(--font-heading);
    font-size: var(--heading-size);
    font-weight: 700;
    line-height: 0.9;
  }

  .stack__list {
    margin: 0;
    border-top: 1px solid var(--rule);
  }

  .stack__group {
    padding: 20px 0 24px;
    border-bottom: 1px solid var(--rule);
  }

  .stack__name {
    font-size: 16px;
    font-weight: 600;
    line-height: 1.9;
    color: var(--muted);
  }

  .stack__tools {
    margin: 0;
  }

  /* One run of names with a quiet dot between them, wrapping naturally. */
  .stack__tools ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.15em 0;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-heading);
    font-size: clamp(22px, 1.9vw, 30px);
    font-weight: 700;
    line-height: 1.3;
  }

  .stack__tools li:not(:last-child)::after {
    content: "·";
    margin: 0 0.4em;
    color: var(--muted);
  }

  @media screen and (max-width: 767px) {
    .stack__head,
    .stack__group {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 12px;
    }

    .stack__group {
      row-gap: 4px;
    }
  }
</style>
