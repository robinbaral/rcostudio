---
// Selected Work: each row is a button that opens the project's drawer (ProjectDrawer), except
// coming-soon rows, which are plain lines.
// On desktop a screenshot follows the cursor while hovering a row (scripts/preview.js), and a
// small row of thumbnails, one per image, appears after the name, marking which image the
// preview shows as the cursor moves along the row.
import { projects, projectId } from "../data/projects";
import ProjectDrawer from "./ProjectDrawer.astro";
import { shots } from "../lib/shots";

interface Props {
  // The project whose drawer is open when the page loads (/work/<name>).
  openProject?: string;
}
const { openProject } = Astro.props;

// The hover preview is a single small image, so one size (about 2x its display width) is enough.
// The images run in the drawer's order: drawerImage (when set) in place of the preview, then the gallery.
const order = (p: (typeof projects)[number]) => [p.drawerImage ?? p.preview, ...(p.gallery ?? [])];
const img = await shots(projects.flatMap(order), 960);
const url = (name: string) => img.get(name)!.src;
// Thumbnails sit at the x-height of the name (about 16px), so a small file each is enough.
const thumb = await shots(projects.flatMap(order), 120);
// Coming-soon rows get no hover image and no thumbnails (Robin, 2026-11-15).
const images = (p: (typeof projects)[number]) => (p.soon ? [] : order(p).filter((n): n is string => !!n));
---

<section class="projects" id="work" aria-labelledby="work-heading">
  <h2 class="projects__heading" id="work-heading">Selected Work</h2>
  <ul class="projects__list">
    {
      projects.map((p) => (
        <li>
          {p.soon ? (
            // Coming soon: a plain line, no drawer (Robin, 2026-11-16).
            <div class="project project--soon">
              <span class="project__name">{p.name}</span>
              <span class="project__tags">{p.tags}</span>
            </div>
          ) : (
          // A link to the project's own address (/work/<name>), so it can be opened in a new tab
          // and search engines follow it; a plain click opens the drawer instead (ProjectDrawer).
          <a
            href={`/work/${projectId(p)}`}
            class="project"
            aria-haspopup="dialog"
            aria-controls="project-drawer"
            data-project-open={projectId(p)}
            data-preview={images(p).length ? url(images(p)[0]) : undefined}
            data-previews={images(p).length ? images(p).map(url).join(",") : undefined}
            data-preview-shape={p.portrait ? "portrait" : undefined}
            data-accent={typeof p.accent === "string" ? p.accent : undefined}
            data-accent-on-dark={typeof p.accent === "object" ? p.accent.onDark : undefined}
            data-accent-on-light={typeof p.accent === "object" ? p.accent.onLight : undefined}
          >
            <span class="project__name">
              {p.name}
              {images(p).length > 1 && (
                <span class="project__thumbs" aria-hidden="true">
                  {images(p).map((name, i) => (
                    <img
                      class:list={["project__thumb", { "is-active": i === 0 }]}
                      src={thumb.get(name)!.src}
                      width={thumb.get(name)!.width}
                      height={thumb.get(name)!.height}
                      alt=""
                      loading="lazy"
                      decoding="async"
                    />
                  ))}
                </span>
              )}
            </span>
            <span class="project__tags">{p.tags}</span>
          </a>
          )}
        </li>
      ))
    }
  </ul>
</section>

<div class="preview" aria-hidden="true"><img class="preview__img" alt="" /></div>

<ProjectDrawer openProject={openProject} />

<script src="../scripts/preview.js"></script>
