---
// Items not in `live` are greyed out until their section exists on the page. The home link
// reads just "R&Co." for now; revisit it if the site gets sub-pages. Cases is left out of the
// menu while it only holds placeholders (the section stays on the page).
interface Props {
  live?: string[];
}
const { live = [] } = Astro.props;
const later = [
  { id: "profile", label: "Profile" },
  { id: "services", label: "Services" },
];
---

<nav class="nav" aria-label="Main">
  <a class="nav__link nav__link--current" href="/" aria-current="page">R&amp;Co.</a>
  <a class="nav__link" href="#projects">Projects</a>
  {
    later.map((item) =>
      live.includes(item.id) ? (
        <a class="nav__link" href={`#${item.id}`}>{item.label}</a>
      ) : (
        <span class="nav__link nav__link--soon" aria-disabled="true">{item.label}</span>
      ),
    )
  }
  <a class="nav__link" href="#contact">Contact</a>
</nav>
