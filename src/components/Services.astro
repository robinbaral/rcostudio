---
// Services. Desktop: a left column (title, a note set as a large, light
// paragraph and a quiet contact line) that sticks while the services follow on one after
// another on the right.
// Below 992px it's one column and nothing sticks.
import { services, servicesNote, servicesContact } from "../data/services";

---

<section class="services" id="services" aria-labelledby="services-heading">
  <div class="services__aside">
    <h2 class="services__title" id="services-heading">Services</h2>
    <p class="services__note">{servicesNote}</p>
    <p class="services__contact">
      {servicesContact.lead}{" "}
      <a class="services__link" href="mailto:baralrobin@gmail.com">{servicesContact.link}</a>
    </p>
  </div>

  <div class="services__list">
    {
      services.map((s) => (
        <article class="service" id={`service-${s.id}`} aria-labelledby={`service-${s.id}-name`}>
          <h3 class="service__name" id={`service-${s.id}-name`}>
            {s.name}
          </h3>
          <p class="service__lead">{s.lead}</p>
          <p class="service__text">{s.text}</p>
        </article>
      ))
    }
  </div>
</section>

<style>
  /* Inverted like the projects list: OS-mode colours swapped. */
  .services {
    --ink: var(--color-bg);
    --muted: color-mix(in srgb, var(--color-bg) 50%, var(--color-fg));
    --rule: color-mix(in srgb, var(--color-bg) 20%, var(--color-fg));
    display: grid;
    /* The left column is sized to its content, not a share of the screen, so wide screens
       don't open a gap between it and the services; those take the rest. */
    grid-template-columns: clamp(300px, 26vw, 460px) minmax(0, 1fr);
    column-gap: clamp(48px, 6vw, 120px);
    padding: 0 var(--gutter) var(--projects-padding-y);
    background-color: var(--color-fg);
    color: var(--ink);
    transition:
      background-color 0.2s,
      color 0.2s;
  }

  /* --- Left: title, text and Get in touch, sticking while the services scroll ------------ */
  .services__aside {
    position: sticky;
    top: 0;
    align-self: start;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding-block: var(--projects-padding-y);
  }

  .services__title {
    margin: 0;
    font-family: var(--font-heading);
    font-size: var(--heading-size);
    font-weight: 700;
    line-height: 0.9;
  }

  /* A large, light paragraph in the body font, like a quiet statement. */
  /* It runs about halfway into the column gap, so it can be wider than the left column without
     moving the column (which lines up with Profile and the stack). */
  .services__note {
    width: calc(100% + clamp(24px, 3vw, 60px));
    max-width: 26ch;
    margin: 20px 0 0; /* the same as .service__lead, so they line up */
    font-family: var(--font-sans);
    font-size: clamp(22px, 1.9vw, 30px);
    font-weight: 500;
    line-height: 1.28;
    letter-spacing: -0.005em;
    color: var(--muted);
    text-wrap: pretty;
  }

  /* The contact line: small and muted, the link only marked by an underline. */
  .services__contact {
    margin: 24px 0 0;
    font-size: 16px;
    line-height: 1.4;
    color: var(--muted);
  }

  .services__link {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    transition: color 0.2s ease;
  }

  .services__link:hover,
  .services__link:focus-visible {
    color: var(--muted);
  }

  /* --- Right: the services, one after another --------------------------------------------- */
  /* Even spacing (Robin: it looked scattered): each service is one tight block (name, lead,
     paragraph), with the same gap between services all the way down. The list's top padding
     matches the left column's, so the first name lines up with "Services". */
  .services__list {
    padding-block: var(--projects-padding-y);
  }

  /* The same measure as the Profile text above (58ch at 20px), so lead and paragraph run as
     wide as that text at every window size: the column's width, up to that measure. */
  .service {
    display: flex;
    flex-direction: column;
    max-width: 58ch;
    font-size: 20px;
  }

  .service + .service {
    margin-top: 80px;
  }

  /* No numbers: not every project goes through every step (see the note on the left). */
  .service__name {
    margin: 0;
    font-family: var(--font-heading);
    font-size: var(--heading-size);
    font-weight: 700;
    line-height: 0.9;
  }


  /* The lead: styled and spaced exactly like the note on the left (Robin), so the first
     service's lead lines up with the note, and each lead reads as the opening line of its
     paragraph rather than a second heading. Keep the two in step. */
  .service__lead {
    margin: 20px 0 0;
    font-family: var(--font-sans);
    font-size: clamp(22px, 1.9vw, 30px);
    font-weight: 500;
    line-height: 1.28;
    letter-spacing: -0.005em;
    color: var(--muted);
    text-wrap: pretty;
  }

  /* One paragraph per service, read as running text rather than separate blocks (Robin):
     a comfortable measure, lined up under the lead. */
  .service__text {
    margin: 16px 0 0;
    font-size: 20px;
    line-height: 1.5;
    color: color-mix(in srgb, var(--ink) 80%, var(--color-fg));
    text-wrap: pretty;
  }

  /* --- Smaller screens: one column, nothing sticks ---------------------------------------- */
  @media screen and (max-width: 991px) {
    .services {
      grid-template-columns: minmax(0, 1fr);
    }

    .services__aside {
      position: static;
    }
  }

  @media screen and (max-width: 767px) {
    .services__note {
      width: auto;
      max-width: none;
      font-size: 22px;
    }

    /* A smaller name, so long ones like "Prototyping" and "Development" fit a phone screen. */
    .service__name {
      font-size: 44px;
    }

    .service + .service {
      margin-top: 56px;
    }

    .service__lead {
      max-width: none;
      margin-top: 16px;
      font-size: 22px;
    }

    .service__text {
      max-width: none;
      margin-top: 12px;
      font-size: 18px;
    }
  }
</style>
