---
// Hero with the project previews as a shuffled stack of cards.
// - Mouse: over the stack the cursor becomes the round button, → on the right half (next) and
//   ← on the left (previous); a click shuffles that way.
// - Drag / swipe (mouse + touch), modelled on the Tommy Pickett album stack: the front card
//   follows sideways with a tilt; past 18% of its width it's thrown out to that side and the
//   stack moves on, otherwise it springs back. A tap counts as "next".
// - Touch tablets keep a fixed round button on the card (phones don't: tap or swipe); keyboard
//   users get the arrow keys.
// The project link is the name in the caption, since clicking the stack shuffles it.
import Nav from "./Nav.astro";
import { projects } from "../data/projects";
import path from "node:path";
import sharp from "sharp";

// How many cards show at once (front to back); the rest wait hidden at the back.
const VISIBLE = 5;
// Each card keeps its own place and leans to its own side (alternating, so neighbours differ).
// Only the angle depends on where it is in the stack: about 8° at the back and 1.2° at the
// front, on a curve, so each step towards straight is a little bigger than the one before
// (about 0.4°, 1.3°, 2.1°, then 3° onto the top). Neighbouring cards turn by different
// amounts, and the front card makes the biggest move as it arrives. So moving on throws the
// front card out and turns the others slightly towards straight, never past it (Robin: calm,
// but not static).
const poses = projects.map((_, i) => ({
  x: (i % 2 ? 1 : -1) * (1.5 + ((i * 37) % 40) / 10), // ±1.5 to 5.4% of the card's width
  y: ((i * 53) % 90) / 10 - 4.5, // -4.5 to 4.4% of its height
  side: i % 2 ? 1 : -1,
  v: ((i * 29) % 10) / 20, // a little variation per card, 0 to 0.45°
}));
const tilt = (i: number, pos: number) =>
  poses[i].side * (1.2 + poses[i].v + 6.8 * (1 - ((VISIBLE - 1 - Math.min(pos, VISIBLE - 1)) / (VISIBLE - 1)) ** 2));
const slotStyle = (i: number) => {
  const s = { ...poses[i], r: tilt(i, i) };
  return `--x:${s.x}%;--y:${s.y}%;--r:${s.r}deg;z-index:${projects.length - i};${
    i >= VISIBLE ? "opacity:0;" : ""
  }`;
};
const pad = (n: number) => String(n).padStart(2, "0");
const first = projects[0];

// Each card takes its image's own proportions (site screenshots 16:10, Design Week 16:9, app
// screenshots portrait), read from the file at build time.
const sizes = await Promise.all(
  projects.map(async (p) => {
    const { width = 1440, height = 900 } = await sharp(path.join(process.cwd(), "public", p.preview)).metadata();
    return { width, height };
  }),
);
---

<main class="stack-hero">
  <Nav live={["profile", "services"]} />
  <h1 class="visually-hidden">R&amp;Co. Studio</h1>
  <p class="stack-hero__intro">
    A digital-first design studio that helps businesses find clarity. Shaped by 20+ years
    of experience in strategy, branding, and design.
  </p>

  <div class="stack-hero__stage">
    {/* Page load: the cards stay hidden until the script below deals them in, once every
        image is ready. This runs before the stack's markup on purpose: Safari draws the page
        while it's still reading it, so a script after the stack came too late and the whole
        stack flashed up in place first. Without JavaScript or with reduced motion the cards
        simply sit in place. */}
    <script is:inline>
      if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
        document.documentElement.classList.add("stack-deal");
      }
    </script>
    <div
      class="stack"
      role="region"
      aria-roledescription="carousel"
      aria-label="Selected projects. Use the arrow keys to move through them."
      tabindex="0"
      data-poses={JSON.stringify(poses)}
      data-visible={VISIBLE}
    >
      {
        projects.map((p, i) => (
          <div
            class:list={["stack__card", { "is-front": i === 0 }]}
            style={`${slotStyle(i)}--ar:${sizes[i].width} / ${sizes[i].height};`}
            data-name={p.name}
            data-tags={p.tags}
            data-href={p.href}
            aria-hidden="true"
          >
            <img
              src={p.preview}
              alt=""
              width={sizes[i].width}
              height={sizes[i].height}
              loading="eager"
              fetchpriority={i < VISIBLE ? "high" : "auto"}
              draggable="false"
            />
          </div>
        ))
      }
      <button class="stack__next" type="button" aria-label="Next project">
        <span class="stack__arrow" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <div class="stack-cursor" aria-hidden="true">
    <span class="stack-cursor__dot"><span class="stack__arrow"></span></span>
  </div>

  <div class="stack-hero__caption" aria-live="polite">
    <span class="stack-hero__count"><span data-caption-count>{pad(1)}</span> / {pad(projects.length)}</span>
    <a
      class="stack-hero__project"
      data-caption-link
      href={first.href}
      target="_blank"
      rel="noopener"
    >
      <span data-caption-name>{first.name}</span>
      <span class="stack-hero__tags" data-caption-tags>{first.tags}</span>
      <span class="stack-hero__ext" aria-hidden="true"></span>
    </a>
  </div>

  <div class="stack-hero__wordmark" role="img" aria-label="R&amp;Co Studio"></div>
</main>

<style>
  .stack-hero {
    --stack-ease: cubic-bezier(0.22, 1, 0.36, 1);
    /* For cards settling into place: a touch of overshoot (about 4%) before they come to rest,
       so the stack feels a little alive without bouncing around. */
    --stack-settle: cubic-bezier(0.3, 1.35, 0.5, 1);
    --wordmark-h: calc((100vw - 2 * var(--gutter)) * 217.957 / 1664);
    position: relative;
    display: grid;
    grid-template-rows: auto auto minmax(280px, 1fr) auto auto;
    grid-template-columns: minmax(0, 1fr);
    min-height: 100svh;
    padding: var(--distributor-padding) var(--gutter) var(--distributor-padding-bottom);
    /* Rotated cards may poke past the sides; never let them widen the page. */
    overflow-x: clip;
  }

  .stack-hero__intro {
    max-width: 34ch;
    margin: 32px 0 0;
    font-size: 20px;
    line-height: 135%;
  }

  /* The stage is a size container, so the stack can size itself to the space left over. */
  .stack-hero__stage {
    position: relative;
    z-index: 2;
    /* Spans the caption row too and reaches into the wordmark, so the stack overlaps it. */
    grid-row: 3 / 5;
    grid-column: 1;
    display: grid;
    place-items: center;
    container-type: size;
    margin: 24px 0 calc(var(--wordmark-h) * -0.55);
    pointer-events: none;
    /* A swipe on iOS must not start a text selection (it grabbed the counter). */
    -webkit-user-select: none;
    user-select: none;
  }
  .stack {
    position: relative;
    width: min(58cqw, 128cqh, 720px);
    aspect-ratio: 16 / 10;
    /* The frame the cards are fitted into (cqw/cqh in .stack__card refer to it). */
    container-type: size;
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
    pointer-events: auto;
    cursor: grab;
  }

  /* Tablets and small laptops: the stack sits just above the caption and grows upward into
     the space under the intro, instead of floating in the middle of the stage. The padding
     keeps it clear of the caption; cqh then measures the space above it. */
  @media screen and (min-width: 768px) and (max-width: 1199px) {
    .stack-hero__stage {
      place-items: end center;
      /* Extra room under the front card: the tilted cards behind it reach lower. */
      padding-bottom: calc(var(--wordmark-h) * 0.55 + 64px);
    }

    .stack {
      /* Inset from the page edges, so the tilted cards don't run to the sides. */
      width: min(76cqw, 150cqh, 720px);
    }
  }

  /* Narrower tablets: the stack spans the caption's width too, so the tilted back cards
     must stay above it (white text on a white card disappears). */
  @media screen and (min-width: 768px) and (max-width: 991px) {
    .stack-hero__stage {
      padding-bottom: calc(var(--wordmark-h) * 0.55 + 112px);
    }
  }

  /* Wide screens: the stack grows with the screen, limited by the stage's height first, then
     a 1260px cap. Narrower than this, a bigger stack would cover the caption. */
  @media screen and (min-width: 1200px) {
    .stack {
      width: min(58cqw, 132cqh, 1260px);
    }
  }

  .stack:active {
    cursor: grabbing;
  }

  .stack:focus-visible {
    outline: none;
  }

  .stack:focus-visible .stack__card.is-front {
    outline: 2px solid var(--color-fg);
    outline-offset: 6px;
  }

  .stack__card {
    position: absolute;
    top: 50%;
    left: 50%;
    /* As large as fits the stack frame at the image's own proportions. Tall phone shots may run
       a little above and below the frame (125%), so they don't look tiny next to the sites. */
    width: min(100cqw, 125cqh * (var(--ar)));
    aspect-ratio: var(--ar);
    overflow: hidden;
    border-radius: 6px;
    /* No fill behind the image: on a tilted, rounded card a fill shows through the image's
       anti-aliased edge as a dark hairline. */
    box-shadow: 0 12px 32px rgb(0 0 0 / 0.18);
    /* --nx/--ny: a small nudge from the script, so a back card never shows as a thin sliver. */
    transform: translate(-50%, -50%) translate(calc(var(--x) + var(--dx, 0px) + var(--nx, 0px)), calc(var(--y) + var(--ny, 0px))) rotate(calc(var(--r) + var(--dr, 0deg)));
    transition:
      transform 0.75s var(--stack-settle),
      opacity 0.4s ease;
  }

  .stack__card img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }

  /* Following the finger or mouse: no easing. */
  .stack__card.is-dragging {
    transition: none;
  }

  /* Let go before the swipe distance: spring back with a little overshoot. */
  .stack__card.is-springing {
    transition: transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  /* Thrown out to one side (--out: 1 right, -1 left), from wherever the drag left it. The
     distance is half the stack (cqw) plus most of the card's own width (%), so narrow portrait
     cards clear the wide cards behind them too, not just their own width. */
  .stack__card.is-leaving {
    transform: translate(-50%, -50%) translate(calc(var(--out, 1) * (60cqw + 60%)), -3%) rotate(calc(var(--r) + var(--out, 1) * 4deg));
    transition: transform 0.3s cubic-bezier(0.33, 1, 0.68, 1);
  }

  /* Page load: until the deal is over, each card's own place is a full screen width off to
     the right (the hero clips the overflow), so nothing shows while the images load. This is
     the cards' real resting place for now, not just the animation's first frame: Safari draws
     a frame or more without the animation when one starts, and with the cards resting in the
     stack that showed the whole stack in place before it jumped off screen. The separate
     translate and rotate properties sit on top of the card's transform, so the stack's own
     layout stays untouched. */
  :global(:root.stack-deal) .stack__card {
    translate: calc(100vw + 100%) -3%;
    rotate: 8deg;
  }

  /* The deal: each card comes in from off screen and stays put at the end ("both": off screen
     until its turn, in place once it's done). The script then drops the off-screen place and
     the animation together, once the front card has landed. A gentler overshoot than a
     shuffle: the overshoot is a share of the distance travelled, and this is a long way. */
  @keyframes stack-deal {
    from {
      translate: calc(100vw + 100%) -3%;
      rotate: 8deg;
    }
    to {
      translate: 0 0;
      rotate: 0deg;
    }
  }

  .stack.is-dealing .stack__card {
    animation: stack-deal 0.5s cubic-bezier(0.25, 1.1, 0.5, 1) both;
  }

  /* One by one, 200ms apart, back card first: the first five cards are the visible stack at
     load (VISIBLE in the frontmatter), card 1 in front. */
  .stack.is-dealing .stack__card:nth-child(5) { animation-delay: 0s; }
  .stack.is-dealing .stack__card:nth-child(4) { animation-delay: 0.2s; }
  .stack.is-dealing .stack__card:nth-child(3) { animation-delay: 0.4s; }
  .stack.is-dealing .stack__card:nth-child(2) { animation-delay: 0.6s; }
  .stack.is-dealing .stack__card:nth-child(1) { animation-delay: 0.8s; }

  /* The round button only shows once the front card has landed. */
  :global(:root.stack-deal) .stack__next,
  .stack.is-dealing .stack__next {
    opacity: 0;
    pointer-events: none;
  }

  .stack__next {
    position: absolute;
    /* On the front card's right edge, whatever its shape (--front-w/-h set by the script). */
    top: calc((100% - var(--front-h, 100%)) / 2 + var(--front-h, 100%) * 0.12);
    right: calc((100% - var(--front-w, 100%)) / 2);
    z-index: 100;
    display: grid;
    place-items: center;
    width: 72px;
    height: 72px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background-color: var(--color-fg);
    color: var(--color-bg);
    box-shadow: 0 6px 16px rgb(0 0 0 / 0.16);
    cursor: pointer;
    translate: 50% 0;
    transition:
      top 0.6s var(--stack-ease),
      right 0.6s var(--stack-ease);
  }

  .stack__next:focus-visible {
    outline: 2px solid var(--color-fg);
    outline-offset: 4px;
  }

  .stack__arrow {
    width: 22px;
    height: 22px;
    background-color: currentColor;
    -webkit-mask: url("/assets/icons/arrow-right.svg") center / contain no-repeat;
    mask: url("/assets/icons/arrow-right.svg") center / contain no-repeat;
    transition: rotate 0.3s var(--stack-ease);
  }

  /* The cursor button: only with a mouse. Hidden until the pointer is over the stack. */
  .stack-cursor {
    display: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .stack {
      cursor: none;
    }

    /* The fixed button gives way to the cursor; it comes back for keyboard focus. */
    .stack__next:not(:focus-visible) {
      opacity: 0;
      pointer-events: none;
    }

    .stack-cursor {
      position: fixed;
      top: 0;
      left: 0;
      z-index: 50;
      display: block;
      pointer-events: none;
      will-change: transform;
    }

    .stack-cursor__dot {
      display: grid;
      place-items: center;
      width: 72px;
      height: 72px;
      margin: -36px 0 0 -36px;
      border-radius: 50%;
      background-color: var(--color-fg);
      color: var(--color-bg);
      box-shadow: 0 6px 16px rgb(0 0 0 / 0.16);
      scale: 0;
      transition: scale 0.35s var(--stack-ease);
    }

    .stack-cursor.is-visible .stack-cursor__dot {
      scale: 1;
    }

    .stack-cursor.is-pressed .stack-cursor__dot {
      scale: 0.88;
    }

    .stack-cursor.is-prev .stack__arrow {
      rotate: 180deg;
    }
  }

  .stack-hero__caption {
    position: relative;
    z-index: 3;
    grid-row: 4;
    grid-column: 1;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    margin-bottom: 12px;
    font-family: var(--font-heading);
    font-size: 16px;
    font-weight: 700;
    line-height: 1.2;
  }

  .stack-hero__count {
    font-variant-numeric: tabular-nums;
    -webkit-user-select: none;
    user-select: none;
  }

  .stack-hero__project {
    display: flex;
    align-items: baseline;
    gap: 12px;
    text-align: right;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  a.stack-hero__project[href]:hover,
  a.stack-hero__project[href]:focus-visible {
    color: color-mix(in srgb, var(--color-fg) 55%, var(--color-bg));
  }

  /* No link (coming soon, no public site): plain text, no arrow. */
  a.stack-hero__project:not([href]) {
    cursor: default;
  }

  .stack-hero__tags {
    opacity: 0.5;
  }

  .stack-hero__ext {
    align-self: center;
    width: 0.7em;
    height: 0.7em;
    background-color: currentColor;
    -webkit-mask: url("/assets/icons/arrow-right.svg") center / contain no-repeat;
    mask: url("/assets/icons/arrow-right.svg") center / contain no-repeat;
    rotate: -45deg;
  }

  a.stack-hero__project:not([href]) .stack-hero__ext {
    display: none;
  }

  .stack-hero__wordmark {
    position: relative;
    z-index: 1;
    width: 100%;
    aspect-ratio: 1664 / 217.957;
    background-color: var(--color-fg);
    -webkit-mask: url("/assets/brand/rco-studio-wordmark.svg") center / contain no-repeat;
    mask: url("/assets/brand/rco-studio-wordmark.svg") center / contain no-repeat;
  }

  @media screen and (max-width: 767px) {
    .stack-hero__intro {
      margin-top: 24px;
      font-size: 17px;
    }

    /* Centre the stack between the intro and the caption: the stage's content box runs from
       the intro's bottom to the caption's top (the padding covers the caption row and the
       part of the stage that reaches into the wordmark). */
    .stack-hero__stage {
      margin-top: 0;
      padding-bottom: calc(var(--wordmark-h) * 0.55 + 12px + 1.2 * 14px);
    }

    .stack {
      width: min(92cqw, 140cqh);
    }

    /* No round arrow on phones: a tap or swipe on the stack moves it on. */
    .stack__next {
      display: none;
    }

    .stack-hero__caption {
      font-size: 14px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stack__card,
    .stack__card.is-leaving,
    .stack__card.is-springing {
      transition: opacity 0.2s ease;
    }
  }
</style>

<script>
  const stack = document.querySelector<HTMLElement>(".stack");
  if (stack) {
    const poses: { x: number; y: number; side: number; v: number }[] = JSON.parse(stack.dataset.poses ?? "[]");
    const VISIBLE = Number(stack.dataset.visible ?? 5);
    // The same angle rule as on the server (see the note at the top).
    const pose = (i: number, pos: number) => ({
      x: poses[i].x,
      y: poses[i].y,
      r: poses[i].side * (1.2 + poses[i].v + 6.8 * (1 - ((VISIBLE - 1 - Math.min(pos, VISIBLE - 1)) / (VISIBLE - 1)) ** 2)),
    });
    const cards = Array.from(stack.querySelectorAll<HTMLElement>(".stack__card"));
    const button = stack.querySelector<HTMLButtonElement>(".stack__next")!;
    const cursor = document.querySelector<HTMLElement>(".stack-cursor")!;
    const count = document.querySelector<HTMLElement>("[data-caption-count]")!;
    const link = document.querySelector<HTMLAnchorElement>("[data-caption-link]")!;
    const nameEl = document.querySelector<HTMLElement>("[data-caption-name]")!;
    const tagsEl = document.querySelector<HTMLElement>("[data-caption-tags]")!;
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
    const mouse = window.matchMedia("(hover: hover) and (pointer: fine)");

    let order = cards.map((_, i) => i); // order[0] is the front card
    let busy = false;
    const SWIPE = 0.18; // share of the card width a drag must travel to count as a swipe
    const T_OUT = 300; // ms, matches .is-leaving

    const place = () => {
      order.forEach((cardIndex, pos) => {
        const card = cards[cardIndex];
        const s = pose(cardIndex, pos);
        card.style.setProperty("--x", `${s.x}%`);
        card.style.setProperty("--y", `${s.y}%`);
        card.style.setProperty("--r", `${s.r}deg`);
        card.style.zIndex = String(cards.length - pos);
        card.style.opacity = pos >= VISIBLE ? "0" : "";
        card.classList.toggle("is-front", pos === 0);
      });
      applyNudges();
      const front = cards[order[0]];
      stack.style.setProperty("--front-w", `${front.offsetWidth}px`);
      stack.style.setProperty("--front-h", `${front.offsetHeight}px`);
      count.textContent = String(order[0] + 1).padStart(2, "0");
      nameEl.textContent = front.dataset.name ?? "";
      tagsEl.textContent = front.dataset.tags ?? "";
      if (front.dataset.href) {
        link.href = front.dataset.href;
        link.setAttribute("aria-label", `${front.dataset.name}, ${front.dataset.tags} (opens in a new tab)`);
      } else {
        link.removeAttribute("href");
        link.removeAttribute("aria-label");
      }
    };

    // No slivers: cards differ in size and shape, so a back card can end up almost flush with
    // the cards in front and show only as a thin strip or wedge along one edge. Each card is
    // treated as its real tilted outline. For every edge of a back card we sample points and
    // measure how far each visible point lies from the cards in front; an edge that shows at
    // all but never more than MIN_EDGE wide is a sliver. The card then gets the smallest nudge
    // (--nx/--ny) that leaves none. Worked out from the cards' resting places, not mid-move.
    // At least 2.5% of the card's width (about 8px on a phone), at most 16px on larger screens:
    // the cards' offsets scale with their size, so a fixed 16px can't be met on small cards.
    let MIN_EDGE = 16; // px, set from the card size in avoidSlivers
    type Pt = { x: number; y: number };
    // Each card's exact size, not offsetWidth/offsetHeight (rounded to whole pixels): half a
    // pixel is the difference between a hidden corner and a hairline. Measured once per layout
    // (cleared on resize).
    const sizes = new Map<HTMLElement, { w: number; h: number }>();
    const sizeOf = (card: HTMLElement) => {
      let size = sizes.get(card);
      if (!size) {
        const cs = getComputedStyle(card);
        size = { w: parseFloat(cs.width), h: parseFloat(cs.height) };
        sizes.set(card, size);
      }
      return size;
    };
    const corners = (card: HTMLElement, s: { x: number; y: number; r: number }, nx: number, ny: number): Pt[] => {
      const { w, h } = sizeOf(card);
      const a = (s.r * Math.PI) / 180, cos = Math.cos(a), sin = Math.sin(a);
      const cx = (s.x / 100) * w + nx, cy = (s.y / 100) * h + ny;
      return [[-w / 2, -h / 2], [w / 2, -h / 2], [w / 2, h / 2], [-w / 2, h / 2]].map(([x, y]) => ({
        x: cx + x * cos - y * sin,
        y: cy + x * sin + y * cos,
      }));
    };
    const segDist = (p: Pt, a: Pt, b: Pt) => {
      const dx = b.x - a.x, dy = b.y - a.y;
      const t = Math.max(0, Math.min(1, ((p.x - a.x) * dx + (p.y - a.y) * dy) / (dx * dx + dy * dy)));
      return Math.hypot(p.x - a.x - t * dx, p.y - a.y - t * dy);
    };
    // Distance from a point to a convex outline: 0 inside, else to the nearest edge.
    const polyDist = (p: Pt, poly: Pt[]) => {
      let inside = true;
      for (let i = 0; i < 4 && inside; i++) {
        const a = poly[i], b = poly[(i + 1) % 4];
        if ((b.x - a.x) * (p.y - a.y) - (b.y - a.y) * (p.x - a.x) < 0) inside = false;
      }
      if (inside) return 0;
      let d = Infinity;
      for (let i = 0; i < 4; i++) d = Math.min(d, segDist(p, poly[i], poly[(i + 1) % 4]));
      return d;
    };
    const SAMPLES = 48; // points per edge for the cycle-wide pass
    const FINE = 120; // points per edge for the current arrangement
    // How bad the slivers on a card are: for each edge that shows but too thinly, how far it
    // falls short of MIN_EDGE. 0 means none.
    // Kept fast, as it runs hundreds of thousands of times when the nudges are worked out (it
    // took 0.6 to 4s in Chrome and held up the page-load deal in Safari). An edge that shows
    // at least MIN_EDGE wide at any point can't be a sliver, whatever the finer search would
    // add, so sampling stops there; firstOnly stops at the first sliver, for hasSliver. Both
    // give the same answers as checking everything.
    const sliverScore = (poly: Pt[], front: Pt[][], samples = SAMPLES, firstOnly = false) => {
      let score = 0;
      for (let i = 0; i < 4; i++) {
        const a = poly[i], b = poly[(i + 1) % 4];
        const p = { x: 0, y: 0 };
        const width = (t: number) => {
          p.x = a.x + (b.x - a.x) * t;
          p.y = a.y + (b.y - a.y) * t;
          let m = Infinity;
          for (let f = 0; f < front.length && m > 0; f++) m = Math.min(m, polyDist(p, front[f]));
          return m;
        };
        let widest = 0, at = 0;
        for (let k = 0; k <= samples && widest < MIN_EDGE; k++) {
          const w = width(k / samples);
          if (w > widest) [widest, at] = [w, k / samples];
        }
        if (widest >= MIN_EDGE) continue;
        // A wedge's widest point can fall between samples: home in on it around the widest one.
        if (widest > 0) {
          let lo = Math.max(0, at - 1 / samples), hi = Math.min(1, at + 1 / samples);
          for (let n = 0; n < 24; n++) {
            const m1 = lo + (hi - lo) / 3, m2 = hi - (hi - lo) / 3;
            if (width(m1) < width(m2)) lo = m1;
            else hi = m2;
          }
          widest = Math.max(widest, width((lo + hi) / 2));
        }
        if (widest > 0.5 && widest < MIN_EDGE) {
          score += MIN_EDGE - widest;
          if (firstOnly) return score;
        }
      }
      return score;
    };
    const hasSliver = (poly: Pt[], front: Pt[][], samples = SAMPLES) => sliverScore(poly, front, samples, true) > 0;
    // Nudges to try, smallest first (a 2px grid up to 40px each way).
    const NUDGES: Pt[] = [];
    for (let x = -40; x <= 40; x += 2) for (let y = -40; y <= 40; y += 2) NUDGES.push({ x, y });
    NUDGES.sort((p, q) => Math.hypot(p.x, p.y) - Math.hypot(q.x, q.y));
    // One fixed nudge per card, good for the whole cycle: the order is always a rotation of the
    // cards, so each card only ever has the same few neighbours in front of it. Nothing moves
    // when the stack moves on; the nudges are only worked out again when the window resizes.
    // The fixed nudges (worked out for the whole cycle below) and a small extra correction for
    // the current arrangement: the angles change a little per position, so one fixed nudge can't
    // always suit every pairing. Where it doesn't, the card shifts by at most 10px more, along
    // with its turn towards straight.
    let fixed: Pt[] = cards.map(() => ({ x: 0, y: 0 }));
    const EXTRA: Pt[] = [];
    for (let x = -10; x <= 10; x += 1) for (let y = -10; y <= 10; y += 1) EXTRA.push({ x, y });
    EXTRA.sort((p, q) => Math.hypot(p.x, p.y) - Math.hypot(q.x, q.y));
    const applyNudges = () => {
      const front: Pt[][] = [];
      order.slice(0, VISIBLE).forEach((i, pos) => {
        const card = cards[i], base = fixed[i], s = pose(i, pos);
        let n = base;
        // Checked more finely than the cycle-wide pass: only five cards, and a hairline near a
        // corner can fall between coarser samples.
        if (front.length && hasSliver(corners(card, s, base.x, base.y), front, FINE)) {
          const score = (d: Pt) => sliverScore(corners(card, s, base.x + d.x, base.y + d.y), front, FINE);
          // Small corrections first; only if none works, the wider search. If nothing is clean,
          // the nudge whose thinnest strip comes closest to a proper edge.
          let e = EXTRA.find((d) => score(d) === 0) ?? NUDGES.find((d) => score(d) === 0);
          if (!e) {
            let best = Infinity;
            for (const d of [...EXTRA, ...NUDGES]) {
              const v = score(d);
              if (v < best) [best, e] = [v, d];
            }
          }
          if (e) n = { x: base.x + e.x, y: base.y + e.y };
        }
        card.style.setProperty("--nx", `${n.x}px`);
        card.style.setProperty("--ny", `${n.y}px`);
        front.push(corners(card, s, n.x, n.y));
      });
    };

    const avoidSlivers = () => {
      sizes.clear();
      MIN_EDGE = Math.max(8, Math.min(16, cards[0].offsetWidth * 0.025));
      const n = cards.length;
      const nudges: Pt[] = cards.map(() => ({ x: 0, y: 0 }));
      const outline = ([i, pos]: number[]) => corners(cards[i], pose(i, pos), nudges[i].x, nudges[i].y);
      // For card i: one entry per position it can be seen in, with the cards in front of it
      // then, as [card, position] pairs (their angle depends on their position).
      const frontSets = cards.map((_, i) => {
        const sets: { pos: number; front: number[][] }[] = [];
        for (let pos = 1; pos < Math.min(VISIBLE, n); pos++) {
          const first = (i - pos + n) % n; // the front card of that rotation
          sets.push({ pos, front: Array.from({ length: pos }, (_, k) => [(first + k) % n, k]) });
        }
        return sets;
      });
      for (let round = 0; round < 12; round++) {
        let changed = false;
        cards.forEach((card, i) => {
          const sets = frontSets[i].map(({ pos, front }) => ({ pos, front: front.map(outline) }));
          // How many of this card's positions would show a sliver with nudge d, counting only
          // up to `limit` (a nudge that reaches it can't be the better one).
          const misses = (d: Pt, limit = Infinity) => {
            let m = 0;
            for (const { pos, front } of sets) {
              if (hasSliver(corners(card, pose(i, pos), d.x, d.y), front) && ++m >= limit) break;
            }
            return m;
          };
          const now = misses(nudges[i]);
          if (now === 0) return;
          // The smallest nudge with no slivers, or failing that, the one with the fewest.
          let best = nudges[i], bestMisses = now;
          for (const d of NUDGES) {
            const m = misses(d, bestMisses);
            if (m < bestMisses) {
              best = d;
              bestMisses = m;
              if (m === 0) break;
            }
          }
          if (best !== nudges[i]) {
            nudges[i] = best;
            changed = true;
          }
        });
        if (!changed) break;
      }
      fixed = nudges;
      applyNudges();
    };

    const clearDrag = (card: HTMLElement) => {
      card.style.removeProperty("--dx");
      card.style.removeProperty("--dr");
    };

    // Next: the front card is thrown out to one side (dir 1 right, -1 left), then tucks in at
    // the back. It leaves from wherever a drag left it.
    const next = (dir = 1) => {
      if (busy) return false;
      const leaving = cards[order[0]];
      order = [...order.slice(1), order[0]];
      if (reduce.matches) {
        clearDrag(leaving);
        place();
        return true;
      }
      busy = true;
      leaving.style.setProperty("--out", String(dir));
      leaving.classList.remove("is-dragging", "is-springing");
      leaving.classList.add("is-leaving");
      window.setTimeout(() => {
        leaving.classList.remove("is-leaving");
        clearDrag(leaving);
        place();
        busy = false;
      }, T_OUT);
      return true;
    };

    // Previous: the back card jumps out to the left, above the stack, then slides in at the front.
    const prev = () => {
      if (busy) return false;
      const incoming = cards[order[order.length - 1]];
      order = [order[order.length - 1], ...order.slice(0, -1)];
      if (!reduce.matches) {
        incoming.style.transition = "none";
        incoming.style.setProperty("--out", "-1");
        incoming.classList.add("is-leaving");
        incoming.style.zIndex = String(cards.length + 1);
        incoming.style.opacity = "";
        void incoming.offsetWidth;
        incoming.style.transition = "";
        incoming.classList.remove("is-leaving");
      }
      place();
      return true;
    };

    // With a mouse, the left half of the stack goes back and the right half goes forward.
    const isLeftHalf = (x: number) => {
      const r = stack.getBoundingClientRect();
      return x < r.left + r.width / 2;
    };

    button.addEventListener("click", (e) => {
      e.stopPropagation();
      next();
    });

    stack.addEventListener("keydown", (e) => {
      if (e.key === "ArrowRight") next();
      else if (e.key === "ArrowLeft") prev();
      else return;
      e.preventDefault();
    });

    // --- Drag / swipe the front card ------------------------------------------------------
    let pointerId: number | null = null;
    let startX = 0;
    let dx = 0;
    let moved = false;

    stack.addEventListener("pointerdown", (e) => {
      if (busy || pointerId !== null || e.button !== 0 || e.target === button || button.contains(e.target as Node)) return;
      pointerId = e.pointerId;
      startX = e.clientX;
      dx = 0;
      moved = false;
      cursor.classList.add("is-pressed");
    });

    stack.addEventListener("pointermove", (e) => {
      if (e.pointerId !== pointerId) return;
      dx = e.clientX - startX;
      const front = cards[order[0]];
      if (!moved && Math.abs(dx) > 6) {
        moved = true;
        // keep getting moves even when the pointer leaves the stack
        stack.setPointerCapture(e.pointerId);
        front.classList.remove("is-springing");
        front.classList.add("is-dragging");
      }
      if (moved) {
        front.style.setProperty("--dx", `${dx}px`);
        front.style.setProperty("--dr", `${dx * 0.02}deg`);
      }
    });

    const release = (e: PointerEvent) => {
      if (e.pointerId !== pointerId) return;
      pointerId = null;
      cursor.classList.remove("is-pressed");
      const front = cards[order[0]];
      if (!moved) {
        // a tap or click: with a mouse the side decides, on touch it's always next
        if (e.type === "pointerup") {
          if (e.pointerType === "mouse" && isLeftHalf(e.clientX)) prev();
          else next();
        }
        return;
      }
      front.classList.remove("is-dragging");
      if (!(Math.abs(dx) > front.offsetWidth * SWIPE && next(dx < 0 ? -1 : 1))) {
        front.classList.add("is-springing");
        clearDrag(front);
      }
    };
    stack.addEventListener("pointerup", release);
    stack.addEventListener("pointercancel", release);

    // --- Cursor button (mouse only) ---------------------------------------------------------
    let cx = 0;
    let cy = 0;
    let raf = 0;
    const draw = () => {
      raf = 0;
      cursor.style.transform = `translate3d(${cx}px, ${cy}px, 0)`;
    };
    const moveCursor = (e: PointerEvent) => {
      if (!mouse.matches || e.pointerType !== "mouse") return;
      cx = e.clientX;
      cy = e.clientY;
      cursor.classList.toggle("is-prev", isLeftHalf(e.clientX) && pointerId === null);
      if (!raf) raf = requestAnimationFrame(draw);
    };
    stack.addEventListener("pointerenter", (e) => {
      if (e.pointerType !== "mouse") return;
      moveCursor(e);
      draw();
      cursor.classList.add("is-visible");
    });
    stack.addEventListener("pointermove", moveCursor);
    stack.addEventListener("pointerleave", () => {
      if (pointerId === null) cursor.classList.remove("is-visible");
    });
    // a drag that ends outside the stack hides the cursor button once it's let go
    window.addEventListener("pointerup", (e) => {
      if (e.pointerType === "mouse" && !stack.matches(":hover")) cursor.classList.remove("is-visible");
    });

    // The stack resizes with the window; keep the button on the front card's edge.
    let sliverFrame = 0;
    // The observer also fires once when it starts watching. That first call is skipped: the
    // nudges were just worked out below, and running the heavy sliver pass again on the first
    // frame blocked Safari's main thread for about 1.5s, right as the cards were dealt in, so
    // they all landed at once.
    let firstResize = true;
    new ResizeObserver(() => {
      if (firstResize) {
        firstResize = false;
        return;
      }
      const front = cards[order[0]];
      stack.style.setProperty("--front-w", `${front.offsetWidth}px`);
      stack.style.setProperty("--front-h", `${front.offsetHeight}px`);
      // At most once a frame while the window is being resized.
      cancelAnimationFrame(sliverFrame);
      sliverFrame = requestAnimationFrame(avoidSlivers);
    }).observe(stack);

    avoidSlivers();
    place();

    // --- Page load: deal the cards in from the right ---------------------------------------
    // The cards wait off screen (see :root.stack-deal in the styles). The whole stack waits
    // until every card's image has loaded and decoded (all of them, not
    // just the visible five, and all loaded eagerly: about 700KB together), so no card comes
    // in blank or fills in late. 6s at most, in case one never arrives. Then the cards are
    // dealt in one after another, back card first, so the front card lands last, on top. The
    // motion and the stagger are all CSS (.is-dealing and @keyframes stack-deal); the script
    // only starts it. Shuffling waits until the front card has landed.
    const root = document.documentElement;
    if (root.classList.contains("stack-deal")) {
      busy = true;
      const loaded = (img: HTMLImageElement) =>
        (img.complete
          ? Promise.resolve()
          : new Promise((resolve) => {
              img.addEventListener("load", resolve, { once: true });
              img.addEventListener("error", resolve, { once: true });
            })
        ).then(() => img.decode().catch(() => {}));
      const ready = Promise.all(cards.map((card) => loaded(card.querySelector("img")!)));
      const timeout = new Promise((resolve) => window.setTimeout(resolve, 6000));
      Promise.race([ready, timeout]).then(() => {
        stack.classList.add("is-dealing");
        const front = cards[order[0]];
        const done = (e: AnimationEvent) => {
          if (e.target !== front) return;
          front.removeEventListener("animationend", done);
          // Every card now rests in place through the animation's end state; dropping that and
          // the off-screen place together leaves them exactly where they are.
          root.classList.remove("stack-deal");
          stack.classList.remove("is-dealing");
          busy = false;
        };
        front.addEventListener("animationend", done);
      });
    }
  }
</script>
