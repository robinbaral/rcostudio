---
import "../styles/global.css";
import { services } from "../data/services";

interface Props {
  // Test pages: keep them out of search results.
  noindex?: boolean;
}
const { noindex = false } = Astro.props;

const name = "R&Co. Studio";
// No locale in the title: clients can be anywhere. No bullet separators (Robin).
const title = `${name} – Digital-first design studio`;
const description =
  "A digital-first design studio that helps growing businesses find clarity. Shaped by 20+ years of experience in strategy, branding, and design.";
const url = "https://rcostudio.nz/";
const ogImage = "https://rcostudio.nz/assets/og/og-image.png";
const ogImageAlt = "R&Co. Studio in white type on a dark background";

// Structured data: the studio (with its services from src/data/services.ts) and the site.
// Based in New Zealand, working with clients anywhere.
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${url}#studio`,
      name,
      alternateName: "R&Co Studio",
      url,
      description,
      logo: "https://rcostudio.nz/assets/icons/favicon-512.png",
      image: ogImage,
      email: "baralrobin@gmail.com",
      telephone: "+64 21 082 039 40",
      address: { "@type": "PostalAddress", addressLocality: "Napier", addressCountry: "NZ" },
      areaServed: "Worldwide",
      knowsAbout: ["Strategy", "Branding", "Web design", "UI/UX design", "Prototyping", "Web development"],
      hasOfferCatalog: {
        "@type": "OfferCatalog",
        name: "Services",
        itemListElement: services.map((s) => ({
          "@type": "Offer",
          itemOffered: {
            "@type": "Service",
            name: s.name,
            description: s.lead,
          },
        })),
      },
    },
    {
      "@type": "WebSite",
      "@id": `${url}#website`,
      url,
      name,
      inLanguage: "en",
      publisher: { "@id": `${url}#studio` },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />
    <link rel="canonical" href={url} />

    <meta property="og:title" content={name} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:site_name" content={name} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={name} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Summary for language models" />

    <link rel="icon" type="image/png" sizes="48x48" href="/assets/icons/favicon-48.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/assets/icons/favicon-192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/assets/icons/favicon-512.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/icons/apple-touch-icon.png" />

    <meta name="theme-color" content="#141414" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />

    <link rel="preload" href="/assets/fonts/general-sans-600.woff2" as="font" type="font/woff2" crossorigin />

    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body class="body">
    <slot />
  </body>
</html>
