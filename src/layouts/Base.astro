---
import "../styles/global.css";
import { services } from "../data/services";

interface Props {
  // Test pages: keep them out of search results.
  noindex?: boolean;
  // Sub-pages: their own title, description and path; the homepage uses the defaults.
  pageTitle?: string;
  pageDescription?: string;
  // Browser bar colour on phones: the colour at the top of the page (dark by default).
  path?: string;
  // Link previews: an image of the page itself (project pages); the studio's otherwise.
  shareImage?: { src: string; width: number; height: number; alt: string };
}
const { noindex = false, pageTitle, pageDescription, path = "/", shareImage } = Astro.props;

const name = "R&Co. Studio";
// No locale in the title: clients can be anywhere. No bullet separators (Robin).
const title = pageTitle ? `${pageTitle} – ${name}` : `${name} – Digital-first design studio`;
// Not the hero line: names the town once for local search, without leaning on it (Robin).
const siteDescription =
  "A digital-first design studio in Napier, NZ, working with clients worldwide. Shaped by 20+ years of experience in strategy, branding, development, and design.";
const description = pageDescription ?? siteDescription;
const siteUrl = "https://rcostudio.nz/";
const url = new URL(path, siteUrl).href;
const ogImage = "https://rcostudio.nz/assets/og/og-image.png";
const ogImageAlt = "R&Co. Studio in white type on a dark background";
const share = shareImage ?? { src: ogImage, width: 1200, height: 630, alt: ogImageAlt };
// Link previews name the page on sub-pages, the studio on the homepage.
const shareTitle = pageTitle ? title : name;

// Structured data: the studio (with its services from src/data/services.ts) and the site.
// Based in New Zealand, working with clients anywhere. ProfessionalService is a kind of
// LocalBusiness, so search engines can tie the studio to Napier for local results; the
// address stays at town level (no street: a service-area business). Add profile links
// (LinkedIn, Google Business Profile …) as `sameAs` once they exist.
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfessionalService",
      "@id": `${siteUrl}#studio`,
      name,
      alternateName: "R&Co Studio",
      url: siteUrl,
      description: siteDescription,
      logo: "https://rcostudio.nz/assets/icons/favicon-512.png",
      image: ogImage,
      email: "baralrobin@gmail.com",
      telephone: "+64 21 082 039 40",
      address: { "@type": "PostalAddress", addressLocality: "Napier", addressRegion: "Hawke's Bay", addressCountry: "NZ" },
      areaServed: [
        { "@type": "AdministrativeArea", name: "Hawke's Bay, New Zealand" },
        { "@type": "Country", name: "New Zealand" },
        "Worldwide",
      ],
      knowsAbout: ["Strategy", "Branding", "Graphic design", "Web design", "UI/UX design", "Prototyping", "Web development"],
      hasOfferCatalog: {
        "@type": "OfferCatalog",
        name: "Services",
        itemListElement: services.map((s) => ({
          "@type": "Offer",
          itemOffered: {
            "@type": "Service",
            name: s.name,
            description: s.lead,
          },
        })),
      },
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}#website`,
      url: siteUrl,
      name,
      inLanguage: "en",
      publisher: { "@id": `${siteUrl}#studio` },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />
    <link rel="canonical" href={url} />

    <meta property="og:title" content={shareTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:site_name" content={name} />
    <meta property="og:image" content={share.src} />
    <meta property="og:image:width" content={String(share.width)} />
    <meta property="og:image:height" content={String(share.height)} />
    <meta property="og:image:alt" content={share.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={shareTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={share.src} />
    <meta name="twitter:image:alt" content={share.alt} />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Summary for language models" />

    <link rel="icon" type="image/png" sizes="48x48" href="/assets/icons/favicon-48.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/assets/icons/favicon-192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/assets/icons/favicon-512.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/icons/apple-touch-icon.png" />

    {/* The browser bar takes the page colour: light, or dark in dark mode (global.css). */}
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#1f1f1f" />

    <link rel="preload" href="/assets/fonts/general-sans-600.woff2" as="font" type="font/woff2" crossorigin />

    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body class="body">
    <slot />
  </body>
</html>
