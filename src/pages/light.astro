---
// A copy of the homepage with every section light and only the footer dark, for Robin to compare
// with the live colour scheme (2026-11-15). Same components as index.astro; only the colours
// are overridden below. Not linked anywhere and kept out of search results (noindex, not in
// the sitemap).
import Base from "../layouts/Base.astro";
import HeroStack from "../components/HeroStack.astro";
import Projects from "../components/Projects.astro";
import Profile from "../components/Profile.astro";
import Services from "../components/Services.astro";
import Cases from "../components/Cases.astro";
import Stack from "../components/Stack.astro";
import Footer from "../components/Footer.astro";
---

<Base noindex themeColor="#ffffff" path="/light">
  <HeroStack />
  <Projects />
  <Profile />
  <Services />
  <Cases />
  <Stack />
  <Footer />
</Base>

<style is:global>
  /* The page itself (nav, hero, Profile, Cases) on white. */
  body {
    --color-fg: #141414;
    --color-bg: #ffffff;
    color-scheme: light;
  }

  /* Projects, Services and the Stack are drawn as the inverse of the page; swapping the pair
     back inside them keeps them white too. */
  .projects,
  .services,
  .stack {
    --color-fg: #ffffff;
    --color-bg: #141414;
  }

  /* Only the footer stays dark. */
  .footer-reveal {
    --color-fg: #ffffff;
    --color-bg: #141414;
    color-scheme: dark;
    color: var(--color-fg);
  }
</style>
