---
// Pindrop's privacy policy, linked from App Store Connect. Replaces the Figma Sites page
// (naming-afar-11830036.figma.site/privacy). Keep it in step with the app's privacy label
// ("Data Not Collected").
import AppPage from "../../layouts/AppPage.astro";
---

<AppPage
  app="Pindrop"
  slug="pindrop"
  icon="/assets/apps/pindrop-icon-256.png"
  accent="#ffe74c"
  title="Privacy policy"
  description="Pindrop doesn't collect, store or share any personal data."
>
  <h1>Privacy policy</h1>
  <p class="meta">Last updated 21 November 2026</p>

  <p class="lede">Pindrop doesn't collect, store or share any personal data. There are no accounts, servers, ads, analytics or tracking.</p>

  <h2>What stays on your iPhone</h2>
  <p>Player names, scores, game history and your settings are saved on your iPhone only. They never leave it, and they're deleted when you delete the app.</p>

  <h2>Third parties</h2>
  <p>Pindrop doesn't use any third-party services, analytics or advertising networks.</p>

  <h2>Children</h2>
  <p>Pindrop is for all ages and collects no data from anyone, children included.</p>

  <h2>Changes</h2>
  <p>If this ever changes, this page will say so first, with a new date at the top.</p>

  <h2>Questions</h2>
  <p>Email <a href="mailto:pindropapp@proton.me">pindropapp@proton.me</a>.</p>
</AppPage>
